{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:clean": "rimraf .next .tsbuildinfo && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "tsx --test \"lib/**/*.test.ts\" \"store/**/*.test.ts\" \"stores/**/*.test.ts\"",
    "test:browser:refix": "node scripts/refix-browser-smoke.cjs",
    "test:browser:purchases": "node scripts/products-purchases-smoke.cjs",
    "test:browser:settings": "node scripts/settings-smoke.cjs",
    "format": "prettier --check \"**/*.{ts,tsx,css}\"",
    "analyze": "ANALYZE=true next build",
    "analyze:browser": "ANALYZE=browser next build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.6",
    "@supabase/ssr": "^0.12.7",
    "@tanstack/react-query": "^5.64.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "rimraf": "^6.1.3",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
