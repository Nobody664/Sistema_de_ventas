# Supabase Postgres direct connection. Replace the password placeholder.
# URL-encode reserved characters in the database password.
DATABASE_URL="postgresql://postgres:YOUR_SUPABASE_DATABASE_PASSWORD@db.<your-project>.supabase.co:5432/postgres?sslmode=require"

# Direct connection for Prisma Migrate. Use the same Supabase password.
DIRECT_URL="postgresql://postgres:YOUR_SUPABASE_DATABASE_PASSWORD@db.<your-project>.supabase.co:5432/postgres?sslmode=require"

# TLS con Postgres. Supabase lo exige; poner false solo para Postgres local.
# DB_SSL_REJECT_UNAUTHORIZED=true exige un CA valido en DB_SSL_CA.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Contraseña en TEXTO PLANO de los usuarios demo.
# El seed aplica argon2.hash() sobre este valor: no poner aqui un hash argon2.
SEED_DEFAULT_PASSWORD="replace-with-a-strong-password"

# Poner en true solo en bases de datos de prueba, para que el seed
# resetee el password de las cuentas demo ya existentes.
SEED_RESET_PASSWORDS=false

# Secretos de firma JWT en texto plano y aleatorio (nunca un hash argon2).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_TTL=60m
JWT_REFRESH_TTL=30d

# MercadoPago: token de integración (solo si usas checkout con MercadoPago).
# MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."

# Secreto del webhook de MercadoPago. Sin este valor el endpoint
# POST /payments/webhooks/mercadopago rechaza la notificacion (401),
# protegiendo contra activacion de suscripciones no autorizadas.
# MERCADOPAGO_WEBHOOK_SECRET="..."