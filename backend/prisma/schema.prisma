  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([supplierId, productId])
  @@index([companyId, productId])
  @@index([companyId, supplierId])
  @@map("supplier_products")
}

model SupplierOrder {
  id            String              @id @default(cuid())
  companyId     String              @map("company_id")
  supplierId    String              @map("supplier_id")
  status        SupplierOrderStatus @default(DRAFT)
  reference     String?
  isAutoGenerated Boolean           @default(false) @map("is_auto_generated")
  notes         String?
  totalEstimated Decimal?           @map("total_estimated") @db.Decimal(14, 4)
  sentAt        DateTime?           @map("sent_at")
  confirmedAt   DateTime?           @map("confirmed_at")
  cancelledAt   DateTime?           @map("cancelled_at")
  receivedAt    DateTime?           @map("received_at")
  createdById   String?             @map("created_by_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier  Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  createdBy User?              @relation("SupplierOrderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     SupplierOrderItem[]

  @@index([companyId, status])
  @@index([companyId, supplierId])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id                String   @id @default(cuid())
  orderId           String   @map("order_id")
  productId         String   @map("product_id")
  suggestedQuantity Decimal  @map("suggested_quantity") @db.Decimal(14, 3)
  requestedQuantity Decimal  @map("requested_quantity") @db.Decimal(14, 3)
  unitCost          Decimal? @map("unit_cost") @db.Decimal(12, 4)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  order   SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("supplier_order_items")
}

model CreditNote {
  id            String             @id @default(cuid())
  companyId     String             @map("company_id")
  saleId        String             @map("sale_id")
  noteNumber    String             @map("note_number")
  type          CreditNoteType     @default(CREDIT)
  reason        CreditNoteReason   @default(RETURN)
  status        CreditNoteStatus   @default(ISSUED)
  subtotal      Decimal            @db.Decimal(12, 2)
  taxAmount     Decimal            @map("tax_amount") @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal            @map("total_amount") @db.Decimal(12, 2)
  description   String?
  issuedAt      DateTime           @default(now()) @map("issued_at")
  createdById   String?            @map("created_by_id")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale      Sale            @relation(fields: [saleId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("CreditNoteCreator", fields: [createdById], references: [id], onDelete: SetNull)
  items     CreditNoteItem[]

  @@unique([companyId, noteNumber])
  @@index([companyId, createdAt])
  @@index([companyId, saleId])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String   @id @default(cuid())
  creditNoteId String   @map("credit_note_id")
  productId    String?  @map("product_id")
  description  String
  quantity     Decimal  @db.Decimal(14, 3)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 4)
  totalPrice   Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  product    Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([creditNoteId])
  @@index([productId])
  @@map("credit_note_items")
}
