generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "postgresql"
  relationMode = "foreignKeys"
}

// ==========================================
// ENUMS
// ==========================================

enum CompanyStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  PAST_DUE
  INACTIVE
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
  CANCELED
}

enum PaymentProvider {
  STRIPE
  MERCADOPAGO
  PAYPAL
  CASH
  CARD
  TRANSFER
  YAPE
  PLIN
}

enum GlobalRole {
  SUPER_ADMIN
  SUPPORT_ADMIN
  ADMIN
  USER
}

enum MembershipRole {
  COMPANY_ADMIN
  MANAGER
  CASHIER
  VIEWER
  DISTRIBUTOR
}

enum DistributorType {
  INDIVIDUAL
  COMPANY
}

enum DistributorStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

enum SaleChannel {
  POS
  DISTRIBUTOR
  ONLINE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
  PENDING
}

enum CreditNoteType {
  CREDIT
  DEBIT
}

enum CreditNoteReason {
  RETURN
  DISCOUNT
  CORRECTION
  OTHER
}

enum CreditNoteStatus {
  ISSUED
  APPLIED
  CANCELLED
}

enum NotificationType {
  SALE
  PAYMENT
  INVENTORY
  SUBSCRIPTION
  SYSTEM
  PLAN_UPGRADED
  PLAN_UPGRADE_REQUEST
  SUBSCRIPTION_APPROVED
  SUBSCRIPTION_REJECTED
  SUBSCRIPTION_PENDING
  LOW_STOCK
  PAYMENT_RECEIVED
  PAYMENT_FAILED
  PAYMENT_PROOF_PENDING
  NEW_COMPANY_REGISTRATION
  CHECKOUT_REQUEST_PENDING
  ACCOUNT_ACTIVATED
  ACCOUNT_APPROVED
  TRIAL_EXPIRING_SOON
  TRIAL_EXPIRED
  NEW_SALE
  NEW_CUSTOMER
  SALE_COMPLETED
  SALE_RETURNED
  PRODUCT_EXPIRING_SOON
  GENERAL
}

enum FinanceDirection {
  ENTRY
  EXIT
}

enum FinanceCategory {
  PURCHASE
  SALE
  PAYROLL
  ELECTRICITY
  WATER
  MAINTENANCE
  OTHER
}

enum NotificationChannel {
  EMAIL
  IN_APP
  SMS
  WHATSAPP
}

enum PlanUpgradeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CheckoutRequestStatus {
  DRAFT
  SUBMITTED
  REVIEWING
  APPROVED
  REJECTED
  CANCELLED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  RETURN
  LOSS
  TRANSFER
}

enum InventoryCostMethod {
  FIFO
  WEIGHTED_AVERAGE
}

enum UnitOfMeasure {
  UNIT
  KG
  LT
  MT
}

enum RefreshTokenType {
  SESSION
  RESET
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==========================================
// MODELS
// ==========================================

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  fullName     String     @map("full_name")
  globalRole   GlobalRole @default(USER)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships   Membership[]
  employee      Employee?
  notifications Notification[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  distributor   Distributor?
  platformSettings   PlatformSetting[] @relation("PlatformSettingAuthor")
  platformAuditLogs  PlatformAuditLog[] @relation("PlatformAuditActor")

  supportTicketsRequested   SupportTicket[] @relation("SupportTicketRequester")
  supportTicketsAssigned    SupportTicket[] @relation("SupportTicketAssignee")
  supportComments           SupportTicketComment[] @relation("SupportCommentAuthor")
  supportStatusChanges      SupportTicketStatusHistory[] @relation("SupportStatusChanger")
  supportConversationsCreated  SupportConversation[] @relation("SupportConversationCreator")
  supportConversationsAssigned SupportConversation[] @relation("SupportConversationAssignee")
  supportParticipations     SupportConversationParticipant[] @relation("SupportParticipantUser")
  supportMessages           SupportMessage[] @relation("SupportMessageSender")
  supportFaqsCreated        SupportFaq[] @relation("SupportFaqCreator")
  supportFaqsUpdated        SupportFaq[] @relation("SupportFaqUpdater")
  supplierOrdersCreated     SupplierOrder[] @relation("SupplierOrderCreator")
  creditNotesCreated        CreditNote[] @relation("CreditNoteCreator")
}

model Company {
  id                  String              @id @default(cuid())
  name                String
  slug                String              @unique
  legalName           String?             @map("legal_name")
  taxId               String?             @map("tax_id")
  address             String?
  email               String?
  phone               String?
  timezone            String              @default("America/Lima")
  currency            String              @default("PEN")
  status              CompanyStatus       @default(TRIAL)
  inventoryCostMethod InventoryCostMethod @default(WEIGHTED_AVERAGE) @map("inventory_cost_method")
  trialEndsAt         DateTime?           @map("trial_ends_at")
  profileComplete     Boolean             @default(false) @map("profile_complete")
  profileCompletedAt  DateTime?           @map("profile_completed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  products      Product[]
  categories    Category[]
  memberships   Membership[]
  customers     Customer[]
  presentations ProductPresentation[]
  stockEntries  StockEntry[]
  subscriptions Subscription[]
  sales         Sale[]
  employees     Employee[]
  invoices      InvoiceTemplate[]
  notifications Notification[]
  auditLogs     AuditLog[]
  purchaseReceipts PurchaseReceipt[]

  inventoryMovements  InventoryMovement[]
  planUpgradeRequests PlanUpgradeRequest[]
  checkoutRequests    CheckoutRequest[]
  branches            Branch[]
  productBatches      ProductBatch[]
  kardexEntries       InventoryKardex[]
  refreshTokens       RefreshToken[]
  distributors        Distributor[]
  distributorDeliveries DistributorDelivery[]
  financeRecords      FinanceRecord[]
  supportTickets      SupportTicket[]
  supportConversations SupportConversation[]
  supportCategories   SupportCategory[]
  supportFaqs         SupportFaq[]
  apiUsage            ApiUsage[]
  discountCoupons     DiscountCoupon[]
  suppliers           Supplier[]
  supplierProducts    SupplierProduct[]
  supplierOrders      SupplierOrder[]
  creditNotes         CreditNote[]

  @@map("companies")
}

model Plan {
  id                    String       @id @default(cuid())
  code                  String       @unique
  name                  String
  description           String?
  priceMonthly          Decimal      @map("price_monthly") @db.Decimal(10, 2)
  priceYearly           Decimal      @map("price_yearly") @db.Decimal(10, 2)
  billingCycle          BillingCycle @default(MONTHLY)
  maxUsers              Int          @default(1)
  maxProducts           Int          @default(100)
  features              Json?
  modules               Json?
  permissions           Json?
  apiEnabled            Boolean      @default(false) @map("api_enabled")
  apiSearchDniEnabled   Boolean      @default(false) @map("api_search_dni_enabled")
  apiQuota              Int          @default(0) @map("api_quota")
  isActive              Boolean      @default(true) @map("is_active")
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")

  subscriptions       Subscription[]
  planUpgradeRequests PlanUpgradeRequest[]
  checkoutRequests    CheckoutRequest[]

  @@map("plans")
}

model ApiUsage {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  period    String
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, period])
  @@index([companyId])
  @@map("api_usage")
}

model Subscription {
  id                     String             @id @default(cuid())
  companyId              String             @map("company_id")
  planId                 String             @map("plan_id")
  status                 SubscriptionStatus @default(TRIALING)
  provider               PaymentProvider    @default(CASH)
  billingCycle           BillingCycle       @default(MONTHLY)
  startDate              DateTime           @map("start_date")
  endDate                DateTime           @map("end_date")
  autoRenew              Boolean            @default(true) @map("auto_renew")
  providerSubscriptionId String?            @map("provider_subscription_id")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan          Plan           @relation(fields: [planId], references: [id])
  payments      Payment[]
  paymentProofs PaymentProof[]

  @@unique([companyId])
  @@index([planId])
  @@index([status, endDate])
  @@map("subscriptions")
}

model Membership {
  id        String         @id @default(cuid())
  userId    String         @map("user_id")
  companyId String         @map("company_id")
  role      MembershipRole @default(CASHIER)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
  @@index([companyId])
  @@map("memberships")
}

model Customer {
  id            String    @id @default(cuid())
  companyId     String    @map("company_id")
  firstName     String    @map("first_name")
  lastName      String?   @map("last_name")
  email         String?
  phone         String?
  documentType  String?   @map("document_type")
  documentValue String?   @map("document_value")
  address       String?
  notes         String?
  paidAt        DateTime? @map("paid_at")
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  @@unique([companyId, email])
  @@unique([companyId, documentValue])
  @@index([companyId])
  @@index([companyId, deletedAt])
  @@map("customers")
}

model Category {
  id          String    @id @default(cuid())
  companyId   String    @map("company_id")
  name        String
  slug        String
  description String?
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([companyId, slug])
  @@index([companyId, deletedAt])
  @@map("categories")
}

model Product {
  id            String    @id @default(cuid())
  companyId     String    @map("company_id")
  categoryId    String?   @map("category_id")
  name          String
  sku           String?
  description   String?
  salePrice     Decimal        @map("sale_price") @db.Decimal(12, 4)
  costPrice     Decimal?       @map("cost_price") @db.Decimal(12, 4)
  baseUnit      UnitOfMeasure  @default(UNIT) @map("base_unit")
  stockQuantity Decimal        @default(0) @map("stock_quantity") @db.Decimal(14, 3)
  minStock      Decimal        @default(5) @map("min_stock") @db.Decimal(14, 3)
  reorderPoint  Decimal?       @map("reorder_point") @db.Decimal(14, 3)
  safetyStock   Decimal?       @map("safety_stock") @db.Decimal(14, 3)
  leadTimeDays  Int?           @map("lead_time_days")
  lastSoldAt    DateTime?      @map("last_sold_at")
  isActive      Boolean        @default(true) @map("is_active")
  imageUrl      String?        @map("image_url")
  barcode       String?
  expiryDate    DateTime?      @map("expiry_date")
  deletedAt     DateTime?      @map("deleted_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category           Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  batches            ProductBatch[]
  kardexEntries      InventoryKardex[]
  presentations      ProductPresentation[]
  stockEntryItems    StockEntryItem[]
  supplierProducts   SupplierProduct[]
  supplierOrderItems SupplierOrderItem[]
  creditNoteItems    CreditNoteItem[]

  @@unique([companyId, sku])
  @@unique([companyId, barcode])
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([categoryId])
  @@map("products")
}

model Sale {
  id             String          @id @default(cuid())
  companyId      String          @map("company_id")
  customerId     String?         @map("customer_id")
  employeeId     String?         @map("employee_id")
  distributorId  String?         @map("distributor_id")
  couponId       String?         @map("coupon_id")
  channel        SaleChannel     @default(POS)
  saleNumber     String          @map("sale_number")
  status         SaleStatus      @default(COMPLETED)
  subtotal       Decimal         @db.Decimal(12, 2)
  taxAmount      Decimal         @map("tax_amount") @db.Decimal(12, 2)
  discountAmount Decimal?        @map("discount_amount") @db.Decimal(12, 2)
  totalAmount    Decimal         @map("total_amount") @db.Decimal(12, 2)
  paymentMethod  PaymentProvider @default(CASH)
  paidAmount     Decimal         @map("paid_amount") @db.Decimal(12, 2)
  changeAmount   Decimal         @map("change_amount") @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  employee    Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  coupon      DiscountCoupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  creditNotes CreditNote[]

  @@unique([companyId, saleNumber])
  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@index([companyId, distributorId])
  @@index([couponId])
  @@index([customerId])
  @@index([employeeId])
  @@map("sales")
}

model SaleItem {
  id             String   @id @default(cuid())
  saleId         String   @map("sale_id")
  productId      String   @map("product_id")
  presentationId String?  @map("presentation_id")
  quantity       Decimal  @db.Decimal(14, 3)
  unitPrice      Decimal  @db.Decimal(12, 4)
  totalPrice     Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  sale         Sale                 @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product      Product              @relation(fields: [productId], references: [id], onDelete: Restrict)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@unique([saleId, productId])
  @@index([saleId])
  @@index([productId])
  @@index([presentationId])
  @@map("sale_items")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model DiscountCoupon {
  id          String       @id @default(cuid())
  companyId   String       @map("company_id")
  code        String
  description String?
  type        DiscountType @default(PERCENTAGE)
  value       Decimal      @db.Decimal(12, 2)
  maxUses     Int?         @map("max_uses")
  usedCount   Int          @default(0) @map("used_count")
  minPurchase Decimal?     @map("min_purchase") @db.Decimal(12, 2)
  startsAt    DateTime?    @map("starts_at")
  expiresAt   DateTime?    @map("expires_at")
  isActive    Boolean      @default(true) @map("is_active")
  createdById String?      @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@map("discount_coupons")
}

model Employee {
  id        String         @id @default(cuid())
  companyId String         @map("company_id")
  userId    String?        @unique @map("user_id")
  firstName String         @map("first_name")
  lastName  String?        @map("last_name")
  email     String?
  phone     String?
  dni       String?
  role      MembershipRole @default(CASHIER)
  salary    Decimal?       @db.Decimal(12, 2)
  paymentDay Int?          @map("payment_day")
  isActive  Boolean        @default(true) @map("is_active")
  deletedAt DateTime?      @map("deleted_at")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  sales   Sale[]
  financeRecords FinanceRecord[]

  @@unique([companyId, dni])
  @@index([companyId])
  @@index([companyId, deletedAt])
  @@map("employees")
}

model Branch {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productBatches     ProductBatch[]
  inventoryMovements InventoryMovement[]
  stockEntries       StockEntry[]

  @@index([companyId])
  @@map("branches")
}

model ProductPresentation {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  productId String   @map("product_id")
  name      String
  factor    Decimal  @db.Decimal(14, 3)
  price     Decimal? @db.Decimal(12, 4)
  barcode   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  stockEntryItems    StockEntryItem[]

  @@unique([productId, name])
  @@unique([companyId, barcode])
  @@index([companyId, productId])
  @@map("product_presentations")
}

model StockEntry {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  branchId  String?  @map("branch_id")
  distributorId String? @map("distributor_id")
  supplierId String? @map("supplier_id")
  receiptId String?  @map("receipt_id")
  reference String?
  notes     String?
  entryDate DateTime @default(now()) @map("entry_date")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  supplier Supplier?      @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receipt PurchaseReceipt? @relation(fields: [receiptId], references: [id], onDelete: SetNull)
  items   StockEntryItem[]

  @@index([companyId, createdAt])
  @@index([branchId])
  @@index([distributorId])
  @@index([supplierId])
  @@index([receiptId])
  @@map("stock_entries")
}

model StockEntryItem {
  id             String    @id @default(cuid())
  stockEntryId   String    @map("stock_entry_id")
  productId      String    @map("product_id")
  presentationId String?   @map("presentation_id")
  quantity       Decimal   @db.Decimal(14, 3)
  baseQuantity   Decimal   @map("base_quantity") @db.Decimal(14, 3)
  unitCost       Decimal   @map("unit_cost") @db.Decimal(12, 4)
  expiryDate     DateTime? @map("expiry_date")
  createdAt      DateTime  @default(now()) @map("created_at")

  stockEntry   StockEntry          @relation(fields: [stockEntryId], references: [id], onDelete: Cascade)
  product      Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  presentation ProductPresentation? @relation(fields: [presentationId], references: [id], onDelete: SetNull)

  @@index([stockEntryId])
  @@index([productId])
  @@map("stock_entry_items")
}

model PurchaseReceipt {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  distributorId String?  @map("distributor_id")
  supplierId    String?  @map("supplier_id")
  series        String   @default("BI")
  number        Int
  fullNumber    String   @map("full_number")
  totalAmount   Decimal  @map("total_amount") @db.Decimal(12, 2)
  entryCount    Int      @map("entry_count")
  itemCount     Int      @map("item_count")
  notes         String?
  createdById   String?  @map("created_by_id")
  issuedAt      DateTime @default(now()) @map("issued_at")
  createdAt     DateTime @default(now()) @map("created_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  distributor Distributor? @relation(fields: [distributorId], references: [id], onDelete: SetNull)
  supplier    Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  entries     StockEntry[]

  @@unique([companyId, series, number])
  @@index([companyId, issuedAt])
  @@index([distributorId])
  @@index([supplierId])
  @@map("purchase_receipts")
}

model ProductBatch {
  id                String    @id @default(cuid())
  companyId         String    @map("company_id")
  productId         String    @map("product_id")
  branchId          String?   @map("branch_id")
  batchNumber       String    @map("batch_number")
  quantityReceived  Decimal   @map("quantity_received") @db.Decimal(14, 3)
  quantityAvailable Decimal   @map("quantity_available") @db.Decimal(14, 3)
  purchasePrice     Decimal   @map("purchase_price") @db.Decimal(12, 4)
  expirationDate    DateTime? @map("expiration_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([companyId, productId])
  @@index([expirationDate])
  @@index([productId])
  @@index([branchId])
  @@map("product_batches")
}

model InventoryKardex {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  productId    String   @map("product_id")
  movementId   String?  @map("movement_id")
  movementDate DateTime @map("movement_date")
  movementType String   @map("movement_type")

  qtyIn       Decimal  @default(0) @map("qty_in") @db.Decimal(14, 3)
  unitCostIn  Decimal? @map("unit_cost_in") @db.Decimal(14, 4)
  totalCostIn Decimal? @map("total_cost_in") @db.Decimal(14, 4)

  qtyOut       Decimal  @default(0) @map("qty_out") @db.Decimal(14, 3)
  unitCostOut  Decimal? @map("unit_cost_out") @db.Decimal(14, 4)
  totalCostOut Decimal? @map("total_cost_out") @db.Decimal(14, 4)

  balanceQty       Decimal @map("balance_qty") @db.Decimal(14, 3)
  balanceUnitCost  Decimal @map("balance_unit_cost") @db.Decimal(14, 4)
  balanceTotalCost Decimal @map("balance_total_cost") @db.Decimal(14, 4)

  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([companyId, productId, movementDate])
  @@index([companyId, movementDate])
  @@index([productId])
